<%- include('../partials/header') %>

<div class="container pb-5" style="max-width: 800px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="mb-1 text-primary font-weight-bold"><i class="fa-solid fa-gears me-2 text-accent"></i> Seting Identitas Sekolah</h3>
      <p class="text-secondary mb-0">Ubah variabel nama sekolah, logo, alamat, email, dan nama kepala sekolah untuk cetakan rapot keagamaan.</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-secondary-custom btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Dashboard Admin
    </a>
  </div>

  <div class="card-glass p-4 p-md-5">
    <form action="/admin/settings" method="POST">
      
      <!-- Input Hidden for Base64 Logo -->
      <input type="hidden" name="logo_base64" id="logo_base64" value="<%= setting.logo_base64 || '' %>">

      <!-- Nama Sekolah -->
      <div class="mb-4">
        <label for="nama_sekolah" class="form-label font-weight-bold">Nama Sekolah</label>
        <input type="text" class="form-control border-secondary text-white bg-transparent" id="nama_sekolah" name="nama_sekolah" value="<%= setting.nama_sekolah %>" required placeholder="Contoh: SMK Bakti Nusantara 666">
        <small class="text-muted">Nama sekolah akan dicetak di kop surat rapot.</small>
      </div>

      <!-- Alamat Sekolah -->
      <div class="mb-4">
        <label for="alamat" class="form-label font-weight-bold">Alamat Sekolah</label>
        <textarea class="form-control border-secondary text-white bg-transparent" id="alamat" name="alamat" rows="2" required placeholder="Contoh: Jalan Raya Cileunyi No. 666, Bandung"><%= setting.alamat %></textarea>
        <small class="text-muted">Alamat lengkap sekolah yang akan dicantumkan di kop surat rapot.</small>
      </div>

      <!-- Email Sekolah -->
      <div class="mb-4">
        <label for="email" class="form-label font-weight-bold">Email Sekolah</label>
        <input type="email" class="form-control border-secondary text-white bg-transparent" id="email" name="email" value="<%= setting.email %>" required placeholder="Contoh: info@smkbn666.sch.id">
        <small class="text-muted">Alamat email resmi sekolah.</small>
      </div>

      <!-- Kepala Sekolah -->
      <div class="mb-4">
        <label for="kepala_sekolah" class="form-label font-weight-bold">Nama Kepala Sekolah</label>
        <input type="text" class="form-control border-secondary text-white bg-transparent" id="kepala_sekolah" name="kepala_sekolah" value="<%= setting.kepala_sekolah %>" required placeholder="Contoh: H. M. Umar, S.Pd., M.M.">
        <small class="text-muted">Nama lengkap kepala sekolah beserta gelarnya untuk tanda tangan rapot.</small>
      </div>

      <!-- Logo Sekolah -->
      <div class="mb-4">
        <label for="logo_file" class="form-label font-weight-bold">Logo Sekolah</label>
        <input type="file" class="form-control border-secondary bg-transparent text-secondary" id="logo_file" accept="image/*">
        <small class="text-muted d-block mt-1">Pilih file gambar logo (PNG, JPG, GIF) berukuran kecil (rekomendasi rasio persegi / square).</small>

        <!-- Preview Logo -->
        <div id="logo_preview_container" class="mt-3 p-3 rounded text-center border border-secondary" style="max-width: 200px; background: rgba(0,0,0,0.1); display: <%= setting.logo_base64 ? 'block' : 'none' %>;">
          <small class="text-secondary d-block mb-2 font-weight-bold">Preview Logo:</small>
          <img id="logo_preview" src="<%= setting.logo_base64 || '' %>" alt="Logo Preview" style="max-height: 80px; object-fit: contain; max-width: 100%;">
          <button type="button" id="btn_clear_logo" class="btn btn-outline-danger btn-xs mt-2 d-block w-100 py-1" style="font-size: 0.75rem;">Hapus Logo</button>
        </div>
      </div>

      <hr class="border-secondary my-4">

      <button type="submit" class="btn btn-primary-custom w-100 py-3">
        <i class="fa-solid fa-circle-check me-2"></i> Simpan Perubahan Seting
      </button>

    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logoFile = document.getElementById('logo_file');
    const logoBase64 = document.getElementById('logo_base64');
    const logoPreview = document.getElementById('logo_preview');
    const logoPreviewContainer = document.getElementById('logo_preview_container');
    const btnClearLogo = document.getElementById('btn_clear_logo');

    // Handle File Upload and conversion to Base64
    logoFile.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        if (!file.type.startsWith('image/')) {
          alert('File harus berupa gambar (format PNG, JPG, GIF, atau SVG)!');
          this.value = '';
          return;
        }

        // Limit file size to 1MB (to prevent massive base64 strings)
        if (file.size > 1024 * 1024) {
          alert('Ukuran gambar logo maksimal adalah 1MB!');
          this.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function(evt) {
          const resultBase64 = evt.target.result;
          logoBase64.value = resultBase64;
          logoPreview.src = resultBase64;
          logoPreviewContainer.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    // Clear logo button
    btnClearLogo.addEventListener('click', () => {
      logoFile.value = '';
      logoBase64.value = '';
      logoPreview.src = '';
      logoPreviewContainer.style.display = 'none';
    });
  });
</script>

<%- include('../partials/footer') %>
